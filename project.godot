[application]
config/name="Still — Atmosphere Channels"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.929,0.945,0.953,1)
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Seven atmospheric channels, from a rainy night laundromat to an immense reservoir of columns. Built in Blender and Godot."

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.065,0.094,0.098,1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[audio]
default_bus_layout="res://default_bus_layout.tres"


[autoload]
Session="*res://scripts/session.gd"

